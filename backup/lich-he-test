server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /srv/lich-he-test/public;
    index index.php index.html;

    client_max_body_size 8M;

    location = /lich-he-test {
        return 301 /lich-he-test/;
    }

    location /lich-he-test/ {
        rewrite ^/lich-he-test/(.*)$ /$1 break;
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }

    location ~ /\. {
        deny all;
    }
}
